{
  "name": "realworld-cypress-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress end-to-end suite for cypress-realworld-app",
  "type": "module",
  "scripts": {
    "open": "cypress open --e2e --browser chrome",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:mobile": "cypress run --config viewportWidth=375,viewportHeight=667",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cypress": "^15.21.0",
    "typescript": "~5.9.3"
  }
}
